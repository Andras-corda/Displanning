# Jeton du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Client ID de l'application Discord (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=

# ID Discord de l'administrateur du bot (autorisé à utiliser /admin — RG-07)
ADMIN_DISCORD_ID=

# Durée du cache horaire en minutes (5 à 15 recommandé)
CACHE_TTL_MINUTES=10
